{
  "appId": "app.knots.desktop",
  "productName": "KNOTS",
  "directories": {
    "output": "../../release"
  },
  "files": ["dist/**/*", "package.json"],
  "asar": true,
  "asarUnpack": ["**/*.node"],
  "npmRebuild": true,
  "publish": null,
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "entitlements": "resources/entitlements.mac.plist"
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Utility",
    "executableName": "knots"
  },
  "icon": "resources/icon.png"
}
